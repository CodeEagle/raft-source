# Copy to .env; generate independent random values locally. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
JWT_SECRET=replace-with-random-secret
SCOPE_ATTESTATION_SECRET=replace-with-another-random-secret
APP_URL=http://localhost:8080
# For manual compose commands only: copy immutable IDs from artifact-manifest.json.
RAFT_SERVER_IMAGE=sha256:replace-from-manifest
RAFT_WEB_IMAGE=sha256:replace-from-manifest
